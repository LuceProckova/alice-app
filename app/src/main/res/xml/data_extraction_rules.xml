<?xml version="1.0" encoding="utf-8"?>
<!-- android 12+, what goes to cloud backup and to a new phone: habits db (with its wal files) and settings, never the share cache -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="alice.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="alice.xml" />
    </device-transfer>
</data-extraction-rules>
